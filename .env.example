# MongoDB Atlas free tier connection string
# Get one at https://www.mongodb.com/cloud/atlas/register (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cogniflow?retryWrites=true&w=majority



